@using ChickenWeb.Controllers
@using ChickenWeb.Domain.Entities
@model OrderSummary

<div class="container mt-4">
    <h2>Order Summary</h2>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd-MM-yyyy hh:mm tt")</p>

    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>₹@item.Price</td>
                    <td>₹@(item.Quantity* item.Price)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Total</strong></td>
                <td><strong>₹@Model.Items.Sum(i => i.Quantity * i.Price)</strong></td>
            </tr>
        </tfoot>
    </table>

    <div class="alert alert-success mt-3">
         Thank you for your order!
    </div>
</div>
